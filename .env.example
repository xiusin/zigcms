# ZigCMS 环境变量模板
# 复制为 .env 后按需修改；.env 含本地环境信息，已 gitignore 不入库。
# 数据库等基础设施配置见 configs/infra.example.json（复制为 configs/infra.json，同样不入库）。

# SECTION: Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# SECTION: Cache
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
